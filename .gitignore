# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
worktrees/
results/
queue/

# Secret connection config — never commit
.env

# Agent prompt files (generated per-session by launchers)
CLAUDE.md
AGENTS.md

# Experimental code/artifacts
dev/

# Results file
results.tsv
legacy_results.tsv/

# Archived campaigns (results.tsv + reports/ + state snapshots from a
# completed run, kept for later comparison). Hundreds of MB of real GPU
# output -- recoverable on disk, never in git.
archive/

# Logs folder (training runs, diagnostics)
logs/

# Runtime-generated agent state (JSON state files and saved model checkpoints)
state/metadata.json
state/report_tracking.json
state/models/
state/noise_floor.json
state/search_planner_state.json
state/llm_usage.json
state/parallel_hyperparams/
state/cluster_hypotheses_signature.json
# The region registry (state/regions.py): every region this campaign has
# opened, its anchor, run history and lifecycle flag. Rewritten on every
# wave. Runtime state, unlike the hand-curated state/campaign_annotations.json
# above, which stays tracked. Replaces state/agent4_region_flags.json, which
# was a second region store with its own identity scheme.
state/regions.json
# One SearchPlannerState per region -- each region has its own cold-start
# counter, frozen set and Gauss-Southwell block rotation.
state/search_planner/

# Runtime-generated hyperparams (written by Agent 1 every iteration, synced
# to the remote server via SFTP directly — not via git)
model_hyperparams.yaml

# Generated agent reports (produced during runs)
reports/

# Pytest artifacts
.pytest_cache/

# Test source code is tracked; only generated artefacts above are ignored
