# Copy this file to .env and fill in your values.
# .env is gitignored; this file is safe to commit.

REMOTE_HOST=dgx.ceid.upatras.gr
REMOTE_PORT=22
REMOTE_USER=your_username
REMOTE_PASSWORD=your_password

# Absolute path to the autoresearch repo on the remote server.
REMOTE_REPO=/home/your_username/autoresearch

# Conda environment name on the remote server.
REMOTE_CONDA_ENV=autoresearch

# Command used to activate conda on the remote server.
REMOTE_CONDA_ACTIVATE=source /opt/anaconda3/bin/activate

# --- Multi-GPU parallel search (all optional; sane defaults if unset) ---

# A GPU counts as "available" for discovery purely from these live
# thresholds (queried fresh via nvidia-smi every time) -- there is no
# static exclusion list.
REMOTE_GPU_UTIL_THRESHOLD_PCT=10
REMOTE_GPU_MIN_FREE_MB=8000

# Seconds before a GPU's lock is considered stale (from a crashed run) and
# reclaimed. Defaults to training_budget_seconds + 600 if unset.
REMOTE_GPU_LOCK_STALE_SECONDS=

# Fallback GPU index used only when live discovery fails outright (e.g.
# nvidia-smi unreachable) -- matches the project's old hardcoded default.
REMOTE_DEFAULT_GPU=4
